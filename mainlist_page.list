import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:firebase_analytics/firebase_analytics.dart';
import '../sub/question_page.dart';

class MainlistPage extends StatefulWidget {
  const MainlistPage({super.key});

  @override
  State<StatefulWidget> createState() => _MainlistPage();
}

class _MainlistPage extends State<MainlistPage> {
  // 1. JSON 데이터 로드
  Future<List<dynamic>> loadAsset() async {
    String jsonString = await rootBundle.loadString('res/api/list.json');
    Map<String, dynamic> jsonResponse = jsonDecode(jsonString);
    return jsonResponse['questions'];
  }

  // 2. 피그마 디자인을 위한 데코레이션 데이터 세팅 (인덱스별로 색상과 텍스트 매칭)
  final List<Color> cardColors = [
    const Color(0xFFFFF0F4), // 연한 핑크
    const Color(0xFFEBF7ED), // 연한 그린
    const Color(0xFFE5F0FA), // 연한 블루
  ];

  final List<String> subtitles = [
    "불안형? 회피형?\n나의 연애 유형은?",
    "나에게서 나는\n분위기와 향기는?",
    "나의 업무 스타일은\n어떤 언어와 같을까?"
  ];

  final List<String> emojis = ["💖", "🌿", "💻"];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFFBFBF9), // 피그마의 따뜻한 오프화이트 배경색
      // AppBar를 지우고 SafeArea를 써서 상단 여백을 자연스럽게 만듭니다.
      body: SafeArea(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.center,
          children: [
            const SizedBox(height: 50), // 최상단 여백

            // --- [피그마 헤더 타이틀 부분] ---
            const Text(
              '오늘의 심리 테스트!',
              style: TextStyle(
                fontSize: 28,
                fontWeight: FontWeight.w900,
                color: Color(0xFF1E2235), // 진한 남색빛 텍스트
              ),
            ),
            const SizedBox(height: 10),
            const Text(
              '나에게 꼭 맞는 테스트를 골라보세요!',
              style: TextStyle(
                fontSize: 16,
                color: Colors.grey,
              ),
            ),
            const SizedBox(height: 40),

            // --- [리스트 카드 부분] ---
            Expanded(
              child: FutureBuilder<List<dynamic>>(
                future: loadAsset(),
                builder: (context, snapshot) {
                  if (snapshot.connectionState == ConnectionState.waiting) {
                    return const Center(child: CircularProgressIndicator());
                  } else if (snapshot.hasData) {
                    return ListView.builder(
                      padding: const EdgeInsets.symmetric(horizontal: 24), // 좌우 여백
                      itemCount: snapshot.data!.length,
                      itemBuilder: (context, index) {
                        Map<String, dynamic> item = snapshot.data![index];

                        // 인덱스가 초과해도 에러가 나지 않도록 나머지 연산자(%) 사용
                        int styleIndex = index % 3;

                        return GestureDetector(
                          onTap: () async {
                            // 1. [해결 방법] context를 사용하는 Navigator를 미리 변수에 담아둡니다.
                            // 이렇게 하면 await 이후에 context를 직접 참조하지 않아도 됩니다.
                            final navigator = Navigator.of(context);

                            // 2. 클릭 로그 전송
                            await FirebaseAnalytics.instance.logEvent(
                              name: "test_click",
                              parameters: {"test_name": item['title'].toString()},
                            );

                            // 3. 로그 전송이 끝난 후, 미리 저장해둔 navigator 변수로 화면 이동!
                            navigator.push(MaterialPageRoute(builder: (context) {
                              return QuestionPage(question: item['file'].toString());
                            }));
                          },
                          // --- [개별 카드 디자인 설정] ---
                          child: Container(
                            margin: const EdgeInsets.only(bottom: 24), // 카드와 카드 사이 간격
                            padding: const EdgeInsets.symmetric(vertical: 30), // 카드 내부 위아래 여백
                            decoration: BoxDecoration(
                              color: cardColors[styleIndex], // 리스트에 저장해둔 배경색 적용
                              borderRadius: BorderRadius.circular(24), // 둥근 모서리
                              boxShadow: [
                                BoxShadow(
                                  color: Colors.black.withValues(alpha: 0.05), // 아주 부드러운 그림자
                                  blurRadius: 15,
                                  offset: const Offset(0, 5),
                                ),
                              ],
                            ),
                            child: Column(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: [
                                Text(
                                  '${emojis[styleIndex]} ${item['title']} ${emojis[styleIndex]}',
                                  style: TextStyle(
                                    fontSize: 20,
                                    fontWeight: FontWeight.bold,
                                    // 파란 배경(3번째)일 때 글씨를 파란색으로 처리
                                    color: styleIndex == 2 ? Colors.blue[800] : Colors.black87,
                                  ),
                                ),
                                const SizedBox(height: 12),
                                Text(
                                  subtitles[styleIndex], // 리스트에 저장해둔 서브 타이틀 적용
                                  textAlign: TextAlign.center,
                                  style: const TextStyle(
                                    fontSize: 14,
                                    color: Colors.black54,
                                    height: 1.4, // 줄간격
                                  ),
                                ),
                              ],
                            ),
                          ),
                        );
                      },
                    );
                  } else {
                    return const Center(child: Text('데이터 로딩 실패'));
                  }
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
